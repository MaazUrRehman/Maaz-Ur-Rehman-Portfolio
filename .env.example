# Set the real HTTPS portfolio origin before building for production.
# Production Vercel origin: https://maaz-ur-rehman.vercel.app
# Leave blank for local development; local pages are intentionally noindex.
SITE_URL=

# Optional: false disables indexing on staging; true still requires SITE_URL.
# Vercel preview deployments are automatically noindex.
SEO_INDEXABLE=

# Paste only the content value from the Search Console HTML verification tag.
GOOGLE_SITE_VERIFICATION=

# Optional Bing Webmaster Tools HTML verification token.
BING_SITE_VERIFICATION=
